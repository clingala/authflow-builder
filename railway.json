{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": [
      "node node_modules/prisma/build/index.js migrate deploy"
    ],
    "healthcheckPath": "/api/ready",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ALWAYS"
  }
}
