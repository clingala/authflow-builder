generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions   Session[]
  accounts   Account[]
  projects   Project[]
  configEdits AuthConfigVersion[] @relation("ConfigCreatedBy")
  auditEvents AuditEvent[]         @relation("AuditActor")

  @@map("users")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String
  providerId             String
  userId                 String    @db.Uuid
  accessToken            String?
  refreshToken           String?
  idToken                String?
  accessTokenExpiresAt   DateTime?
  refreshTokenExpiresAt  DateTime?
  scope                  String?
  password               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  ownerId         String        @db.Uuid
  name            String        @db.VarChar(80)
  slug            String        @db.VarChar(96)
  accountType     String        @db.VarChar(50)
  status          ProjectStatus @default(ACTIVE)
  activeConfigId  String?       @unique @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  archivedAt      DateTime?

  owner         User                @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  configVersions AuthConfigVersion[] @relation("ProjectConfigs")
  activeConfig   AuthConfigVersion?  @relation("ActiveProjectConfig", fields: [activeConfigId], references: [id], onDelete: SetNull)
  auditEvents    AuditEvent[]
  runtimeUsers   RuntimeUser[]
  runtimeSessions RuntimeSession[]
  runtimeAuthEvents RuntimeAuthEvent[]
  runtimeRateLimits RuntimeRateLimit[]
  runtimeChallenges RuntimeChallenge[]

  @@unique([ownerId, slug])
  @@index([ownerId, status, updatedAt])
  @@map("projects")
}

model AuthConfigVersion {
  id            String   @id @default(uuid()) @db.Uuid
  projectId     String   @db.Uuid
  version       Int
  schemaVersion Int      @default(1)
  config        Json
  configHash    String   @db.VarChar(64)
  createdById   String   @db.Uuid
  createdAt     DateTime @default(now())

  project       Project  @relation("ProjectConfigs", fields: [projectId], references: [id], onDelete: Cascade)
  activeProject Project? @relation("ActiveProjectConfig")
  createdBy     User     @relation("ConfigCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([projectId, version])
  @@index([createdById])
  @@map("auth_config_versions")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @db.Uuid
  projectId  String?  @db.Uuid
  action     String   @db.VarChar(80)
  targetType String   @db.VarChar(50)
  targetId   String   @db.VarChar(128)
  metadata   Json?
  createdAt  DateTime @default(now())

  actor   User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([projectId, createdAt])
  @@map("audit_events")
}

model RuntimeUser {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  email         String    @db.VarChar(254)
  passwordHash  String    @db.Text
  emailVerified Boolean   @default(false)
  phoneVerified Boolean   @default(false)
  profile       Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  project  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions RuntimeSession[]
  events   RuntimeAuthEvent[]
  challenges RuntimeChallenge[]

  @@unique([projectId, email])
  @@index([projectId, createdAt])
  @@map("runtime_users")
}

model RuntimeSession {
  id         String    @id @default(uuid()) @db.Uuid
  projectId  String    @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique @db.VarChar(64)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ipHash     String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(500)

  project Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    RuntimeUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, expiresAt])
  @@index([userId, revokedAt])
  @@map("runtime_sessions")
}

model RuntimeAuthEvent {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  runtimeUserId String?   @db.Uuid
  eventType     String    @db.VarChar(80)
  outcome       String    @db.VarChar(32)
  ipHash        String?   @db.VarChar(64)
  metadata      Json?
  createdAt     DateTime  @default(now())

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runtimeUser RuntimeUser? @relation(fields: [runtimeUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([runtimeUserId, createdAt])
  @@map("runtime_auth_events")
}

model RuntimeRateLimit {
  keyHash         String   @id @db.VarChar(64)
  projectId       String   @db.Uuid
  action          String   @db.VarChar(40)
  count           Int
  windowStartedAt DateTime
  expiresAt       DateTime
  updatedAt       DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, action, expiresAt])
  @@map("runtime_rate_limits")
}

model RuntimeChallenge {
  id            String    @id @default(uuid()) @db.Uuid
  projectId     String    @db.Uuid
  runtimeUserId String    @db.Uuid
  purpose       String    @db.VarChar(40)
  channel       String    @db.VarChar(20)
  targetHash    String    @db.VarChar(64)
  secretHash    String    @db.VarChar(64)
  attempts      Int       @default(0)
  resendCount   Int       @default(0)
  expiresAt     DateTime
  nextResendAt  DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  runtimeUser RuntimeUser @relation(fields: [runtimeUserId], references: [id], onDelete: Cascade)

  @@index([projectId, purpose, targetHash, createdAt])
  @@index([runtimeUserId, purpose, consumedAt, expiresAt])
  @@map("runtime_challenges")
}
