# Phase 1 has no required secrets. These become required in later phases.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/authflow_builder"
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"

# Provider credentials are server-only. Never prefix secrets with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Adapter credentials (future phases)
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""

