# Local PostgreSQL defaults match compose.yaml. Replace them outside local development.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/authflow_builder"

# Generate at least 32 random bytes. Required when auth endpoints are used.
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"

# Provider credentials are server-only. Never prefix secrets with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Register this exact callback in Google Cloud for each deployment:
# {APP_URL}/api/runtime/projects/{projectId}/oauth/google/callback

# Server-to-server delivery adapter. The endpoint integrates your email/SMS provider.
# It receives signed Bearer requests containing the delivery kind, destination, and
# short-lived link/code. Keep both values server-only.
AUTHFLOW_DELIVERY_WEBHOOK_URL=""
AUTHFLOW_DELIVERY_WEBHOOK_SECRET=""
