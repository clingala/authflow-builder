# Local PostgreSQL defaults match compose.yaml. Replace them outside local development.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/authflow_builder"

# Generate at least 32 random bytes. Required when auth endpoints are used.
AUTH_SECRET="replace-with-at-least-32-random-bytes"
APP_URL="http://localhost:3000"

# Provider credentials are server-only. Never prefix secrets with NEXT_PUBLIC_.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Adapter credentials (future phases)
EMAIL_PROVIDER_API_KEY=""
SMS_PROVIDER_API_KEY=""
